{
  "version": 2,
  "crons": [
    {
      "path": "/api/cron-check-abandoned",
      "schedule": "* * * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/api/shopify/(.*)",
      "destination": "/api/shopify.js"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
